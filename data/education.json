{
  "science_fields_pool": "fields/science",

  "tier_defaults": {
    "doctorate": {
      "grad_age": 28,
      "templates": {"default": "Ph.D. {field}, {institution} {year}"},
      "institution_pool": "institutions/university"
    },
    "md": {
      "grad_age": 26,
      "templates": {"default": "M.D., {institution} {year}"},
      "institution_pool": "institutions/university"
    },
    "jd": {
      "grad_age": 25,
      "templates": {"default": "J.D., {institution} {year}"},
      "institution_pool": "institutions/university"
    },
    "mba": {
      "grad_age": 26,
      "templates": {"default": "M.B.A., {institution} {year}"},
      "institution_pool": "institutions/university"
    },
    "masters": {
      "grad_age": 24,
      "templates": {
        "science": "M.S. {field}, {institution} {year}",
        "arts": "M.A. {field}, {institution} {year}"
      },
      "institution_pool": "institutions/university"
    },
    "bachelors": {
      "grad_age": 22,
      "templates": {
        "science": "B.S. {field}, {institution} {year}",
        "arts": "B.A. {field}, {institution} {year}"
      },
      "institution_pool": "institutions/university"
    },
    "academy": {
      "grad_age": 20,
      "templates": {"default": "{institution} {year}"},
      "institution_pool": "institutions/military-basic"
    },
    "highschool": {
      "grad_age": 18,
      "templates": {"default": "{institution} {year}"},
      "institution_pool": "institutions/highschool"
    }
  },

  "professions": {
    "anthropologist": {
      "fields": ["Anthropology", "Archaeology"],
      "tiers": {"doctorate": 5, "masters": 3, "bachelors": 1}
    },
